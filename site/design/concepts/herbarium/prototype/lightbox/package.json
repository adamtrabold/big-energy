{
  "name": "big-energy-lightbox",
  "private": true,
  "description": "React island: the site's image lightbox (Ramka). Only the lightbox uses React; the rest of the site is vanilla JS.",
  "scripts": {
    "build": "esbuild lightbox.jsx --bundle --minify --format=iife --target=es2019 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=../vendor/lightbox/lightbox.js"
  },
  "dependencies": {
    "@ramka/react": "0.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
