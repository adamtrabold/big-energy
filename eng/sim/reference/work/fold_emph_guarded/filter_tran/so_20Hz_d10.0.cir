* BENCH filter_tran: self-oscillation onset. A small kick into the mixer bus, then free decay
* or growth. Placeholders: ADAPTER CUT R14 KICKW TMAX TSTOP WRFILE TEMP
.include /home/claude/model-d/eng/sim/reference/work/fold_emph_guarded/adapter.inc
.options temp=25 tnom=25 reltol=1e-5 abstol=1e-13 vntol=1e-7 method=gear maxord=2
vp vp 0 10
vn vn 0 -10
vcut cut 0 -9.0000
vsrc src 0 pulse(0 10m 1m 1u 1u 1.2500e-02 1e3)
rmix src ain 33k
rbus ain 0 5.5k
vamt amt 0 0
xf ain cut amt out vp vn dut_vcf r14=0
.control
set wr_singlescale
set wr_vecnames
tran 6.2500e-04 3.0200e+00 0 6.2500e-04
wrdata so_20Hz_d10.0.dat v(out)
quit
.endc
.end
